* text=auto
.gitattributes text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.tcl text eol=lf
*.do text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.mem text eol=lf
*.coe text eol=lf
*.f text eol=lf
*.sha256 text eol=lf
*.docx binary
*.pdf binary

# Preserve source formatting in provenance-carrying RTL and verification inputs.
rtl/** whitespace=-trailing-space,-blank-at-eof
tb/** whitespace=-trailing-space,-blank-at-eof
verification/oracle/** whitespace=-trailing-space,-blank-at-eof
verification/vectors/** whitespace=-trailing-space,-blank-at-eof
